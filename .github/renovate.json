{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 6am on Monday"],
  "packageRules": [
    {
      "description": "Run CI for Renovate dependency updates",
      "matchManagers": ["gomod", "dockerfile", "github-actions", "pre-commit", "tekton"],
      "addLabels": ["ok-to-test"]
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go dependencies",
      "groupSlug": "go-deps"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile dependencies",
      "groupSlug": "dockerfile-deps"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Safe Go dependency updates through Prow and Tide",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["patch", "pin", "pinDigest"],
      "groupName": "safe go dependency updates",
      "groupSlug": "safe-go-deps",
      "automerge": false,
      "platformAutomerge": false,
      "addLabels": ["lgtm", "approved"]
    },
    {
      "description": "Fork replacements require manual updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["replace"],
      "enabled": false
    }
  ]
}
